NEXT_PUBLIC_FIREBASE_API_KEY=

# Self-hosted Umami analytics (base URL of your instance, no trailing slash)
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# PostHog analytics (project API key; ingestion is same-origin via the
# /api/stats reverse proxy in next.config.ts, no host var needed)
NEXT_PUBLIC_POSTHOG_KEY=

# Panel API (server-only, never exposed to the client)
PANEL_API_URL=
PANEL_API_KEY=

# Shared secret the panel presents to POST /api/revalidate after a
# contributions sync, to bust the `activity`/`projects` cache tags early
REVALIDATE_SECRET=